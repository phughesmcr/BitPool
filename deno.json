{
  "name": "@phughesmcr/bitpool",
  "version": "0.7.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "bench": {
    "include": ["bench/**/*.bench.ts"]
  },
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "lib": ["esnext"],
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["example/**/*.ts"],
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "always",
    "useTabs": false,
    "exclude": ["*.md", "LICENSE"]
  },
  "imports": {
    "@phughesmcr/booleanarray": "jsr:@phughesmcr/booleanarray@^0.12.0"
  },
  "tasks": {
    "example": {
      "description": "Run the example",
      "command": "deno run example/BitPool.example.ts"
    },
    "prep": {
      "description": "Format, lint, and check the codebase",
      "command": "deno fmt && deno lint && deno check mod.ts src/**/*.ts test/**/*.test.ts bench/**/*.ts"
    },
    "ci": {
      "description": "Run tests, static checks, and GC allocation budget checks",
      "command": "deno task prep && deno test && deno task bench:allocations:check"
    },
    "bench:allocations": {
      "description": "Measure GC allocation pressure for hot BitPool APIs",
      "command": "deno run --v8-flags=--expose-gc bench/gc_allocations.ts"
    },
    "bench:allocations:check": {
      "description": "Fail if zero-allocation hot paths exceed their GC allocation budgets",
      "command": "deno run --v8-flags=--expose-gc bench/gc_allocations.ts --check"
    }
  },
  "test": {
    "include": ["test/**/*.test.ts"]
  }
}
