{
  "name": "@phughesmcr/bitpool",
  "version": "0.9.1",
  "license": "MIT",
  "exports": "./mod.ts",
  "lock": true,
  "bench": {
    "include": ["bench/**/*.bench.ts"]
  },
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "lib": ["es2025"],
    "module": "esnext",
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "verbatimModuleSyntax": true
  },
  "fmt": {
    "bracePosition": "sameLine",
    "indentWidth": 2,
    "lineWidth": 120,
    "newLineKind": "lf",
    "nextControlFlowPosition": "sameLine",
    "operatorPosition": "sameLine",
    "proseWrap": "always",
    "quoteProps": "consistent",
    "semiColons": true,
    "singleQuote": false,
    "trailingCommas": "onlyMultiLine",
    "useBraces": "whenNotSingleLine",
    "useTabs": false,
    "exclude": ["*.md", "**/*.md", "LICENSE"]
  },
  "lint": {
    "exclude": ["example/**"],
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "no-await-in-sync-fn",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-top-level-await",
        "no-undef",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator"
      ]
    }
  },
  "imports": {
    "@phughesmcr/booleanarray": "jsr:@phughesmcr/booleanarray@^0.13.0"
  },
  "tasks": {
    "example": {
      "description": "Run the example",
      "command": "deno run example/BitPool.example.ts"
    },
    "prep": {
      "description": "Format, lint, and check the codebase",
      "command": "deno fmt && deno lint && deno check mod.ts src/**/*.ts test/**/*.test.ts bench/**/*.ts"
    },
    "ci": {
      "description": "Run tests, static checks, and GC allocation budget checks",
      "command": "CI=1 deno task prep && deno test && deno task bench:allocations:check"
    },
    "bench:allocations": {
      "description": "Measure GC allocation pressure for hot BitPool APIs",
      "command": "deno run --v8-flags=--expose-gc bench/gc_allocations.ts"
    },
    "bench:allocations:check": {
      "description": "Fail if zero-allocation hot paths exceed their GC allocation budgets",
      "command": "deno run --v8-flags=--expose-gc bench/gc_allocations.ts --check"
    }
  },
  "test": {
    "include": ["test/**/*.test.ts"]
  },
  "publish": {
    "exclude": [
      "example/**",
      "bench/**",
      "test/**",
      ".github/**",
      ".vscode/**",
      ".cursor/**",
      ".claude/**"
    ]
  }
}
